# 複製成 .env.local 後填入實際值。.env.local 不會進 git。
#
# 注意：Vite 的 VITE_ 前綴變數會被打包進前端 bundle，屬於「公開值」。
# LINE Channel Secret、Firebase service account key 等機密
# 絕對不可放在這裡，一律存 Apps Script 指令碼屬性（PropertiesService）。

# Apps Script Web App 部署網址
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/xxxxx/exec

# LIFF App ID（公開值）
VITE_LIFF_ID=0000000000-xxxxxxxx
